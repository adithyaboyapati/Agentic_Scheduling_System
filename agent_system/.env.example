# ==============================================================================
# NovaHealth Clinical AI Agent - Environment Configuration Template
# ==============================================================================

# 1. LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 2. LangSmith Observability & Tracing Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=novahealth-healthcare-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 3. Model Configuration Overrides (Optional)
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini
